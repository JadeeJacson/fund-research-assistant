# 复制本文件为 .env，然后填写本地配置。.env 已被 Git 忽略。

# 数据目录和数据库。相对路径以项目根目录为基准。
FUNDLAB_DATA_DIR=data
FUNDLAB_DATABASE_PATH=data/private/fundlab.sqlite3

# 账户整体可接受的历史回撤参考线。0.10 表示 10%。
# 这只是风险门控参数，不代表未来亏损上限。
FUNDLAB_RISK_TOLERANCE=0.10
FUNDLAB_RISK_FREE_RATE=0.00

# AI 开关：false 时系统仍能完整运行确定性分析。
FUNDLAB_AI_ENABLED=false

# DeepSeek 官方 API。不要把真实 Key 提交到 GitHub。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 2026-07 起建议使用 v4 模型；旧的 deepseek-chat/deepseek-reasoner 即将停用。
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=false
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_TOKENS=2200

# 预算保护。0 表示不设置本地日预算上限。
DEEPSEEK_DAILY_BUDGET_USD=0

# 可选价格配置，仅用于本地估算。价格变化时在这里修改，不改业务代码。
DEEPSEEK_INPUT_PRICE_PER_MILLION_USD=0
DEEPSEEK_OUTPUT_PRICE_PER_MILLION_USD=0

