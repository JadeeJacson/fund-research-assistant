# 复制本文件为 .env，然后填写本地配置。.env 已被 Git 忽略。

# 数据库、截图草稿和规则。相对路径以项目根目录为基准。
FUNDLAB_DATABASE_URL=sqlite:///data/private/fundlab_v2.sqlite3
FUNDLAB_UPLOAD_DIR=data/private/uploads-v2
FUNDLAB_RULES_PATH=config/decision_rules.yaml
FUNDLAB_MARKET_PROVIDER=akshare

# AI 开关：false 时系统仍能完整运行确定性分析。
FUNDLAB_AI_ENABLED=false

# DeepSeek 官方 API。不要把真实 Key 提交到 GitHub。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认使用低成本非思考解释模型；需要时可改为 deepseek-v4-pro。
DEEPSEEK_MODEL=deepseek-v4-flash

